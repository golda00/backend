# App
APP_NAME="Telecom Vision API"
APP_VERSION="1.0.0"
DEBUG=false

# Processing
PDF_DPI=300
TILE_SIZE=640
TILE_OVERLAP=0.2
USE_GPU=true

# CORS — space-separated list of allowed origins
# Use "*" for development only
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

MAX_UPLOAD_BYTES=209715200   # 200 MB
JOB_TIMEOUT_SECONDS=1800     # 30 min
PIPELINE_WORKERS=4           # threads (fallback when Celery unavailable)
JOB_RETENTION_HOURS=24       # auto-cleanup

# Redis & Celery (Batch 3)
# Local dev: install Redis and run: redis-server
# Production: set to your managed Redis URL (e.g. Redis Cloud, ElastiCache)
REDIS_URL=redis://localhost:6379/0
